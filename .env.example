# ===== FinanzaPro - variables de entorno (copia este archivo a .env) =====

# Backend
PORT=5000
NODE_ENV=production
# URI de MongoDB Atlas (reemplaza usuario, contraseña y cluster). Incluye el nombre de la BD.
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/finanzapro?retryWrites=true&w=majority
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
# Origen(es) permitidos por CORS (separados por coma). Es la URL desde donde abres el frontend.
CORS_ORIGIN=http://localhost:3000

# Frontend (se incrusta en el build de Vite; es la URL del API vista desde el NAVEGADOR)
VITE_API_URL=http://localhost:5000/api
FRONTEND_PORT=3000
